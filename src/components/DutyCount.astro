---
import { getCollection } from 'astro:content';

const DUTY_PREFIXES = ['a/', 't/', 'r/'];

const dutyDocs = await getCollection('docs', (entry) => {
  const inDutyFolder = DUTY_PREFIXES.some((prefix) => entry.id.startsWith(prefix));
  const isLandingPage = entry.id.split('/').length <= 2;
  return inDutyFolder && !isLandingPage;
});

const dutyCount = dutyDocs.length;
---

{dutyCount}