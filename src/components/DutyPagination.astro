---
// DutyPagination.astro
//
// Manual replacement for Starlight's auto-generated Prev/Next footer,
// for use on duty pages (e.g. /a/shb/1) which aren't sidebar nodes and
// therefore never get pagination context from Starlight itself.
//
// Usage (from a duty .md/.mdx file):
//   import DutyPagination from '../../../components/DutyPagination.astro';
//   ...
//   <DutyPagination />
//

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import iconRaid from '../assets/icons/raids.png';
import iconTrial from '../assets/icons/trials.png';
import iconDungeon from '../assets/icons/dungeons.png';
import iconARR from '../assets/icons/arr.png';
import iconHW from '../assets/icons/heavensward.png';
import iconSB from '../assets/icons/stormblood.png';
import iconSHB from '../assets/icons/shadowbringers.png';
import iconEW from '../assets/icons/endwalker.png';
import iconDT from '../assets/icons/dawntrail.png';

// ADD NEW EXPANSIONS HERE when they release. Omit `icon` entirely
// if artwork doesn't exist yet
const EXPANSIONS: Record<string, { label: string; icon?: ImageMetadata }> = {
  arr: { label: 'A Realm Reborn', icon: iconARR },
  hw: { label: 'Heavensward', icon: iconHW },
  sb: { label: 'Stormblood', icon: iconSB },
  shb: { label: 'Shadowbringers', icon: iconSHB },
  ew: { label: 'Endwalker', icon: iconEW },
  dt: { label: 'Dawntrail', icon: iconDT },
  // ec: { label: 'Evercold' }, // no icon yet
  // next-expansion-shorthand: { label: 'Next Expansion Display Name', icon: iconNext },
};

const DUTY_TYPES: Record<string, { label: string; icon?: ImageMetadata }> = {
  t: { label: 'Trials', icon: iconTrial },
  a: { label: 'Alliance Raids', icon: iconRaid },
  r: { label: 'Raids', icon: iconRaid },
  d: { label: 'Dungeons', icon: iconDungeon },
};

// URL shape is always /{type}/{expansion}/{duty-slug}
const segments = Astro.url.pathname.split('/').filter(Boolean);
const [type, expansion] = segments;

const dutyType = DUTY_TYPES[type] ?? { label: type };
const expansionInfo = EXPANSIONS[expansion] ?? { label: expansion };

const prevHref = `/${type}/${expansion}/`;
const prevLabel = `All ${expansionInfo.label} ${dutyType.label}`;
const prevIcon = expansionInfo.icon;

const nextHref = `/${type}/`;
const nextLabel = `All ${dutyType.label}`;
const nextIcon = dutyType.icon;
---

<div class="pagination-links print:hidden">
  <a class="prev" href={prevHref} rel="prev">
    {prevIcon && <Image src={prevIcon} alt="" width={28} height={28} loading="eager" />}
    <span class="link-title">{prevLabel}</span>
  </a>
  <a class="next" href={nextHref} rel="next">
    <span class="link-title">{nextLabel}</span>
    {nextIcon && <Image src={nextIcon} alt="" width={28} height={28} loading="eager" />}
  </a>
</div>

<style>
  .pagination-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
  }
  .pagination-links a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem;
    text-decoration: none;
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    line-height: var(--sl-line-height-headings);
  }
  .pagination-links a:hover {
    border-color: var(--sl-color-gray-2);
  }
  .pagination-links a img {
    flex-shrink: 0;
    border-radius: 0.25rem;
  }
  .link-title {
    font-size: var(--sl-text-base);
    font-weight: 600;
  }
  .pagination-links .next {
    margin-inline-start: auto;
    text-align: end;
    justify-content: flex-end;
  }
  @media (min-width: 50rem) {
    .pagination-links a {
      width: calc(50% - 0.5rem);
    }
  }
</style>