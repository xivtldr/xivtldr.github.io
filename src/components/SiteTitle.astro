---
import logo from '../assets/logo.png';

const { sidebar } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;
---

<div class="site-header-container">
  <!-- Hamburger Button (Left) -->
  <black-menu-button class="print:hidden">
    <button type="button" aria-expanded="false" aria-controls="starlight__sidebar" aria-label="Menu">
      <div class="hamburger">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
      </div>
    </button>
  </black-menu-button>

  <!-- Logo & Title (Links to Home) -->
  <a href="/" class="custom-site-title">
    <img src={logo.src} alt="" class="site-logo" />
    <span>XIV TLDR</span>
  </a>
</div>

<!-- Mobile Slide-out Navigation Drawer -->
<div class="mobile-nav">
  <div class="mobile-nav-content">
    {
      sidebar.map(
        (entry) =>
          entry.type !== 'link' && (
            <div class="mobile-nav-section">
              <div class="mobile-nav-label">{entry.label}</div>
              <div class="mobile-nav-links">
                {entry.entries.map(
                  (link) =>
                    link.type === 'link' && (
                      <a href={link.href} {...link.attrs} data-active={currentPath === link.href}>
                        {link.label}
                      </a>
                    ),
                )}
              </div>
            </div>
          ),
      )
    }
  </div>
</div>

<script>
  class BlackMenuButton extends HTMLElement {
    btn = this.querySelector('button')!;

    constructor() {
      super();
      this.btn.addEventListener('click', () => this.toggleExpanded());

      const parentNav = this.closest('nav');
      if (parentNav) {
        parentNav.addEventListener('keyup', (e) => this.closeOnEscape(e as KeyboardEvent));
      }

      matchMedia('(min-width: 50em)').addEventListener('change', () => this.setExpanded(false));
    }

    setExpanded(expanded: boolean) {
      this.btn.setAttribute('aria-expanded', String(expanded));
      document.body.toggleAttribute('data-mobile-menu-expanded', expanded);
      document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => {
        el.toggleAttribute('inert', expanded);
      });
    }

    toggleExpanded() {
      this.setExpanded(this.btn.getAttribute('aria-expanded') !== 'true');
    }

    closeOnEscape(e: KeyboardEvent) {
      if (e.code === 'Escape') {
        this.setExpanded(false);
        this.btn.focus();
      }
    }
  }

  if (!customElements.get('black-menu-button')) {
    customElements.define('black-menu-button', BlackMenuButton);
  }
</script>

<style>
  /* Header Container Layout */
  .site-header-container {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    gap: 0.75rem;
  }

  .custom-site-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--sl-color-white);
    font-weight: 700;
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .site-logo {
    height: 1.6rem;
    width: auto;
    object-fit: contain;
  }

  /* Hamburger Toggle Button */
  black-menu-button button {
    all: unset;
    display: inline-flex;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    height: 2rem;
    width: 1.5rem;
    padding: 0;
    color: var(--foreground);
    touch-action: manipulation;
    border-radius: calc(var(--radius) - 2px);
  }

  @media (min-width: 64rem) {
    black-menu-button button {
      display: none;
    }
  }

  .hamburger {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
  }

  .bar {
    display: block;
    position: absolute;
    left: 0;
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 0.5);
    background-color: var(--foreground);
    border-radius: 1px;
    transition: top 100ms ease-out, transform 100ms ease-out;
  }

  .bar-1 { top: calc(var(--spacing) * 1); }
  .bar-2 { top: calc(var(--spacing) * 2.5); }

  black-menu-button button[aria-expanded='true'] .bar-1 {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  black-menu-button button[aria-expanded='true'] .bar-2 {
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  /* Mobile Drawer Overlay */
  :global([data-mobile-menu-expanded]) {
    --black-menu-visibility: visible;
  }

  .mobile-nav {
    visibility: var(--black-menu-visibility, hidden);
    display: flex;
    position: fixed;
    top: var(--sl-nav-height);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: calc(var(--sl-z-index-navbar) + 2);
    background-color: color-mix(in oklab, var(--background) 90%, transparent);
    backdrop-filter: blur(8px);
    flex-direction: column;
    justify-content: flex-start;
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    overflow-y: auto;
    padding: 1.5rem;
    height: 100%;
  }

  .mobile-nav-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-label {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-links a {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: var(--foreground);
    text-decoration: inherit;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>